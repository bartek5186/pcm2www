{
  "database": {
    "driver": "sqlite",
    "path": "~/.config/pcm2www/pcm2www.db",
    "dsn": ""
  },
  "integrations": {
    "woocommerce": {
      "enabled": true,
      "base_url": "https://…",
      "consumer_key": "ck_xxx",
      "consumer_secret": "GGoO .... ....",
      "poll_sec": 10,
      "cache": {
        "prime_on_start": true,
        "sweep_interval_minutes": 360,
        "fields": "id,sku,name,regular_price,sale_price,tax_class,stock_quantity,manage_stock,stock_status,backorders,catalog_visibility,status,hurt_price,ean,global_unique_id,date_modified_gmt,type"
      }
    },
    "importer": {
      "enabled": true,
      "watch_dir": "~/pcm2www/imports",
      "poll_sec": 5,
	  "price_mode": "gross",
	  "stability_seconds": 2
    }
  },
	"auto_start": false,
  "sync_interval_seconds": 10
}
